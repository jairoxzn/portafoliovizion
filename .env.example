# Base de datos (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Credenciales del administrador inicial (usadas solo por prisma/seed.js)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@viziontech.com"
ADMIN_PASSWORD="cambia-esta-contraseña"

# Storage de imágenes (adaptador local desacoplado)
UPLOADS_DIR="./storage/uploads"

# URL pública del sitio (usada para SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
